// Time Complexity: O(n^2)
// Space Complexity: O(n^2)

// Create a 1D array mapped to the 2D board values
// Starting from the 0th index do BFs with every dice roll value and mark visited when accessing an index
// If at any level the last index is reached return the number of dice rolls

class Solution {
    public int snakesAndLadders(int[][] board) {
        int n = board.length;
        int[] boardList = new int[n*n];
        int r = n-1;
        int c = 0;
        boolean flag = true;
        int i = 0;
        // Convert to 1D array
        while(i < n*n) {
            if(board[r][c] == -1)
                boardList[i] = board[r][c];
            else
                boardList[i] = board[r][c] - 1;
            if(flag) {
                c++;
                if(c == n) {
                    r--;
                    c--;
                    flag = false;
                }
            }
            else {
                c--;
                if(c == -1) {
                    r--;
                    c++;
                    flag = true;
                }
            }
            i++;
        }
        
        Queue<Integer> q = new LinkedList<>();
        q.add(0);
        int level = 0;
        while(!q.isEmpty()) {
            int size = q.size();
            for(i = 0; i < size; i++) {
                int curr = q.poll();
                for(int j = 1; j <= 6; j++) {
                    int idx = curr + j;
                    // If last index is reached
                    if(idx == n*n-1 || boardList[idx] == n*n-1)
                        return level + 1;
                    // Check is visisted
                    if(boardList[idx] != -2) {
                        if(boardList[idx] == -1)
                            q.add(idx);
                        else
                            q.add(boardList[idx]);
                        boardList[idx] = -2;
                    }
                }

            }
            level++;
        }
        return -1;
    }
}